# ─── JobPilot-AI Environment Variables Template ───
# Copy this file to .env or configure directly in the Desktop UI / config.json

# 1. LLM API Keys (Choose any or all - free tiers available)
# Get free key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Get free key from: https://build.nvidia.com
NVIDIA_API_KEY=

# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Gmail SMTP & Email Tracking Settings
# Your Gmail account address
GMAIL_SENDER=your_email@gmail.com

# 16-character Google App Password (not your normal password)
# Generate from: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# 3. Path to your PDF resume (defaults to Resume.pdf in root)
RESUME_PDF_PATH=./Resume.pdf
